# People Analytics AJIR - configuration de production.
# Copier en C:\PeopleAnalytics\app\.env puis adapter. Lu par :
#   - Next.js (service web) au démarrage ;
#   - le worker (node --env-file=.env, voir deploy/windows/PeopleAnalyticsWorker.xml) ;
#   - scripts/backup.ts, restore.ts, check-install.ts ;
#   - deploy/windows/env.ps1 pour les commandes manuelles (npm run import, db:migrate...).
# Protéger ce fichier : lecture pour le compte de service et les administrateurs seulement (docs/INSTALLATION.md).
# Ne pas y mettre NODE_ENV : « next start » le fixe à production. tsx (worker et scripts) fait partie des
# dependencies du package.json.
# Pas de commentaire en fin de ligne après une valeur.

# Base SQLite, hors du dossier de l'application (remplacé à chaque mise à jour)
DATABASE_PATH=C:\PeopleAnalytics\data\app.db

# Adresse HTTPS publiée par le reverse proxy (liens d'activation des comptes, contrôle d'origine)
APP_URL=https://people-analytics.client.local

# Nombre de proxys de confiance devant Next.js : 1 derrière le Caddy de deploy/caddy (adresse client lue dans
# X-Forwarded-For pour la limitation de débit par IP et l'audit). 0 ou absent si le port de Next.js est joignable
# sans passer par le proxy (docs/qa/SECURITE_PERF.md § 8).
TRUST_PROXY=1

# Niveau des journaux pino : fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Sauvegardes : autre volume ou partage réseau que la base ; rétention en jours (0 = aucune suppression)
BACKUP_DIR=D:\Sauvegardes\PeopleAnalytics
BACKUP_RETENTION_DAYS=30

# Rétention des données (scripts/retention.ts, npm run retention) : priment sur les paramètres retention_inbox_days
# et retention_prediction_months de l'écran Paramètres. Laisser commenté pour utiliser ces paramètres (90 j, 24 mois).
# RETENTION_INBOX_DAYS=90
# RETENTION_PREDICTION_MONTHS=24

# Port interne du service web : identique à --port de PeopleAnalyticsWeb.xml et au reverse_proxy du Caddyfile.
# Sert à restore.ts et check-install.ts pour sonder /api/health.
PORT=3000

# Seulement si le build a été produit dans un autre dossier que .next (next.config.ts lit NEXT_DIST_DIR)
# NEXT_DIST_DIR=.next

# Démonstration en HTTP sur le réseau local : NE JAMAIS activer en production (cookie de session sans Secure)
# INSECURE_COOKIES=1

# Ouverture du module depuis AJIR par jeton signé (docs/INTEGRATION_AJIR.md) : secret partagé avec AJIR,
# au moins 32 caractères aléatoires. Absent ou plus court = fonctionnalité désactivée (connexion par mot de passe seule).
# AJIR_LAUNCH_SECRET=
